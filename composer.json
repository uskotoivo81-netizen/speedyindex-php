{
    "name": "speedyindex/client",
    "description": "PHP client for the SpeedyIndex API: Google, Bing and Yandex index checks, link indexing, backlink checks, Google Rank Tracker and webhook signatures.",
    "type": "library",
    "license": "MIT",
    "keywords": ["speedyindex", "seo", "google index checker", "indexing", "backlinks", "rank tracker", "serp", "bing", "yandex"],
    "homepage": "https://en.speedyindex.com/api.php",
    "support": {
        "issues": "https://github.com/uskotoivo81-netizen/speedyindex-php/issues",
        "source": "https://github.com/uskotoivo81-netizen/speedyindex-php",
        "docs": "https://en.speedyindex.com/api.php"
    },
    "authors": [{ "name": "SpeedyIndex", "homepage": "https://en.speedyindex.com" }],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": { "psr-4": { "SpeedyIndex\\": "src/" } },
    "scripts": { "test": "php tests/run.php" }
}
